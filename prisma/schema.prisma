generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  color     String?
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  goals     Goal[]
  logs      StudyLog[]
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  FAILED
  CANCELLED
}

model Goal {
  id            Int        @id @default(autoincrement())
  userId        Int
  user          User       @relation(fields: [userId], references: [id])
  examName      String
  target        String
  startDate     DateTime   @db.Date
  examDate      DateTime   @db.Date
  resultDate    DateTime?  @db.Date
  status        GoalStatus @default(ACTIVE)
  finalPenalty  Int?
  penaltyWaived Boolean    @default(false)
  closedAt      DateTime?
  settledAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId, status])
}

model StudyLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  studyDate   DateTime @db.Date
  durationSec Int
  photoUrl    String
  photoPath   String
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, studyDate])
}
